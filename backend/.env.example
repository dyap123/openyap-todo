# Set these with your host's secret manager. Never put real credentials in this file.
FIREBASE_PROJECT_ID=openyap-todo
FIRESTORE_DATABASE_ID=finance
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
PUBLIC_API_BASE=https://api.openyap.org/todo-finance
SCHWAB_REDIRECT_URI=https://api.openyap.org/todo-finance/v1/oauth/callback
APP_URL=https://dyap123.github.io/openyap-todo/
ALLOWED_ORIGINS=https://dyap123.github.io
# 32 random bytes, base64 encoded. Keep stable across restarts.
TOKEN_ENCRYPTION_KEY=
PORT=8080

# Default storage on existing VPS (no Firestore required).
FINANCE_STORE=sqlite
SQLITE_PATH=/data/finance.sqlite
